[{"id": "N6", "group": "t5", "prompt": "Put a flat roof over the building at L2.", "expect": {"kind": "no_proposal"}}, {"id": "N11", "group": "t5", "prompt": "Turn wall w-04 into a curtain wall with 1.5 m mullion spacing.", "expect": {"kind": "no_proposal"}}, {"id": "N15", "group": "t5", "prompt": "Create a wall opening 1 m by 2 m in w-04.", "expect": {"kind": "no_proposal"}}, {"id": "N1", "group": "t5", "prompt": "Add a dimension between columns 1678294 and 1681116.", "expect": {"kind": "no_proposal"}}, {"id": "A4", "group": "t2", "prompt": "Create level L3 at 7.2 m, a 10 m wall on L3 from (0, 0) to (10, 0), and a door of type \"M_Door-Exterior-Single-Two_Lite: 900 x 2000mm\" in its middle.", "expect": {"kind": "any_of", "options": [{"kind": "items", "match": [{"scope": "created", "label": "Levels", "new_contains": ["L3"]}, {"param": "(new wall)", "new_contains": ["on L3"]}, {"param": "(new door)", "new_contains": ["at 5.00 m"]}], "count": 3}, {"kind": "items", "match": [{"scope": "created", "label": "Levels", "new_contains": ["L3"]}, {"param": "(new wall)", "new_contains": ["on L3"]}, {"param": "(new door)", "new_contains": ["at 5.00 m"]}, {"scope": "created", "label": "Views"}], "count": 4}]}}, {"id": "A5", "group": "t2", "prompt": "Add a floor and a ceiling at 2.7 m to every room on L1.", "expect": {"kind": "items", "match": [{"scope": "created", "label": "Floors"}, {"scope": "created", "label": "Ceilings"}], "count": 16}}, {"id": "A12", "group": "t2", "prompt": "Tag all doors in the current view and add a text note Fire check next to door Mark 100.", "expect": {"kind": "items", "match": [{"scope": "created", "label": "Door Tags"}, {"scope": "created", "label": "Text Notes", "new_contains": ["Fire check"]}], "count": 9}}, {"id": "A13", "group": "t2", "prompt": "Create sheet A701 named Agent Test.", "expect": {"kind": "items", "match": [{"scope": "created", "label": "Sheets", "new_contains": ["A701"]}], "count": 1}}, {"id": "D2", "group": "documentation", "prompt": "Add a text note saying Check fire rating next to door zz-99.", "expect": {"kind": "items", "match": [{"scope": "created", "label": "Text Notes", "new_contains": ["Check fire rating"]}], "count": 1}}, {"id": "F1", "group": "floors", "prompt": "Create a floor in room 105.", "expect": {"kind": "items", "match": [{"scope": "created", "label": "Floors"}], "count": 1}}, {"id": "R2", "group": "transform", "prompt": "Mirror wall w-04 about the x axis to create a mirrored copy.", "expect": {"kind": "items", "match": [{"scope": "created", "new_contains": ["-12.173, -12.807", "17.827, -12.807"]}], "count": 1}}, {"id": "E8", "group": "existing", "prompt": "Place a window of type \"M_Window-Casement-Double: 1050 x 1350mm\" in wall w-02, 3 metres from its start.", "expect": {"kind": "items", "match": [{"param": "(new window)", "new_contains": ["in wall 1674187 at 3.00 m"]}], "count": 1}}, {"id": "C1", "group": "create", "prompt": "Create a wall on level L1 from (50, 50) to (55, 50) metres.", "expect": {"kind": "items", "count": 1, "match": [{"scope": "created", "param": "(new wall)", "new_contains": ["on L1", "(50.00, 50.00) to (55.00, 50.00)"]}]}}]