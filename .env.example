# Copy this file to .env (or set the variables in your shell) and fill in real values.
# .env is ignored by Git. Never commit a real key.

# OpenAI API key used by the brain server (required).
BTP_API=your-openai-api-key-here

# Path of the SQLite memory database (optional).
# Default: agent_memory.db in the repository root.
BTP_MEMORY_DB=C:\path\to\BIM_AGENT\agent_memory.db
