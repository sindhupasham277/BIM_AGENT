{
    "query_elements": {
        "name": "query_elements",
        "description": "Query elements of a category after applying optional filters and return selected parameter fields.",
        "input_schema": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "filters": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "parameter": {
                                "type": "string"
                            },
                            "operator": {
                                "type": "string",
                                "enum": [
                                    "==",
                                    "!=",
                                    ">",
                                    "<",
                                    ">=",
                                    "<=",
                                    "contains",
                                    "is_null",
                                    "is_not_null"
                                ]
                            },
                            "value": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "parameter",
                            "operator",
                            "value"
                        ]
                    }
                },
                "return_fields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "category"
            ]
        }
    },
    "aggregate_elements": {
        "name": "aggregate_elements",
        "description": "Aggregate elements of a category (count, sum, avg, min, max) after applying optional filters, optionally grouped by a parameter.",
        "input_schema": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "filters": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "parameter": {
                                "type": "string"
                            },
                            "operator": {
                                "type": "string",
                                "enum": [
                                    "==",
                                    "!=",
                                    ">",
                                    "<",
                                    ">=",
                                    "<=",
                                    "contains",
                                    "is_null",
                                    "is_not_null"
                                ]
                            },
                            "value": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "parameter",
                            "operator",
                            "value"
                        ]
                    }
                },
                "aggregate": {
                    "type": "string",
                    "enum": [
                        "count",
                        "sum",
                        "avg",
                        "min",
                        "max"
                    ]
                },
                "aggregate_field": {
                    "type": "string"
                },
                "group_by": {
                    "type": "string"
                }
            },
            "required": [
                "category",
                "aggregate"
            ]
        }
    },
    "list_audit_rules": {
        "name": "list_audit_rules",
        "description": "List all available BIM audit rules.",
        "input_schema": {
            "type": "object",
            "properties": {},
            "required": []
        }
    },
    "run_audit": {
        "name": "run_audit",
        "description": "Run a specific BIM audit rule and return the elements that violate it.",
        "input_schema": {
            "type": "object",
            "properties": {
                "rule_name": {
                    "type": "string",
                    "description": "The exact name of the audit rule to run."
                }
            },
            "required": [
                "rule_name"
            ]
        }
    },
    "run_generated_snippet": {
        "name": "run_generated_snippet",
        "description": "Run a short read-only Python snippet against the current Revit model when the request requires relationships, combining categories, comparisons, or multi-step logic that cannot be handled by query_elements, aggregate_elements, or run_audit.",
        "input_schema": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "description": "Short Python code using only revit_ro. The code must assign the final answer to a variable named result."
                }
            },
            "required": [
                "code"
            ],
            "additionalProperties": false
        }
    },
    "propose_set_parameter": {
        "name": "propose_set_parameter",
        "description": "Propose setting ONE parameter to ONE value on specific elements. This does NOT change the model: it creates a proposal the user must confirm with a button. element_ids must be the _id values returned by earlier query_elements or run_audit results. If the user has not said which value to use, ask.",
        "input_schema": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "element_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "param_name": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                },
                "audit_name": {
                    "type": "string",
                    "description": "Optional. The audit rule this fix is for, e.g. missing_fire_rating."
                }
            },
            "required": [
                "category",
                "element_ids",
                "param_name",
                "value"
            ],
            "additionalProperties": false
        }
    },
    "query_past_changes": {
        "name": "query_past_changes",
        "description": "Previously APPLIED changes made by this agent, newest first. Use for 'what did we do last time?' questions. All parameters are optional.",
        "input_schema": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer"
                },
                "param_name": {
                    "type": "string"
                },
                "audit_name": {
                    "type": "string"
                },
                "since_days": {
                    "type": "integer"
                }
            },
            "required": [],
            "additionalProperties": false
        }
    },
    "select_elements": {
        "name": "select_elements",
        "description": "Select elements of a category in the Revit user interface, after applying optional filters (same filters as query_elements). This only changes which elements are selected on screen; it does not modify the model and needs no confirmation. Returns how many elements were selected and their IDs.",
        "input_schema": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "filters": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "parameter": {
                                "type": "string"
                            },
                            "operator": {
                                "type": "string",
                                "enum": [
                                    "==",
                                    "!=",
                                    ">",
                                    "<",
                                    ">=",
                                    "<=",
                                    "contains",
                                    "is_null",
                                    "is_not_null"
                                ]
                            },
                            "value": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "parameter",
                            "operator",
                            "value"
                        ]
                    }
                }
            },
            "required": [
                "category"
            ]
        }
    },
    "propose_action": {
        "name": "propose_action",
        "description": "Create a PROPOSED model change from a short Python 2.7 snippet (no f-strings, no imports, no Transaction, no doc). Available methods: revit_rw.get_param(element_id, name), revit_rw.set_param(element_id, name, value), revit_rw.list_levels(), revit_rw.list_wall_types(), revit_rw.create_wall(level_name, x1, y1, x2, y2, wall_type_name=None, height_m=3.0). Lengths are in metres. The snippet first runs as a dry run that is rolled back, and the exact changes are shown to the user on a card. Nothing is applied unless the user clicks Confirm. A snippet that makes no changes returns its result (use this to look up levels or wall types). Assign a short summary to result.",
        "input_schema": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "description": "One short sentence describing the change for the user."
                },
                "code": {
                    "type": "string",
                    "description": "The Python 2.7 snippet, using only the revit_rw methods listed above."
                }
            },
            "required": [
                "description",
                "code"
            ]
        }
    }
}